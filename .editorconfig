# Pin formatting so editors and tools stop fighting over line endings / indentation.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,html,md,yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4

# Windows scripts stay CRLF.
[*.{bat,cmd,vbs,ps1}]
end_of_line = crlf
