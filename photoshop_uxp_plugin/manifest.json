{
  "manifestVersion": 5,
  "id": "local.storyboard.manager.preview-export",
  "name": "Storyboard Manager Bridge",
  "version": "0.6.7",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "storyboardBridgePanel",
      "label": {
        "default": "Storyboard Bridge"
      },
      "minimumSize": {
        "width": 280,
        "height": 300
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 420
      },
      "preferredFloatingSize": {
        "width": 300,
        "height": 420
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": [
        "127.0.0.1",
        "localhost"
      ]
    }
  }
}
